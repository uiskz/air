{
    "name": "uiskz/air",
    "description": "Common interfaces and types for Air content",
    "homepage": "https://github.com/uiskz/air",
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Uiskz\\Air\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Uiskz\\Air\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dmitriy Gritsenko",
            "email": "dg@uis.kz"
        }
    ],
    "require": {
        "php": ">=8.3",
        "uiskz/travel": "^1.0",
        "uiskz/currency": "^1.0",
        "zircote/swagger-php": "^6.0",
        "psr/log": "^3.0",
        "stephenhill/base58": "^2.1",
        "ramsey/uuid": "^4.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "name": "uiskz/currency",
            "type": "path",
            "url": "../uiskz-currency",
            "options": {
                "symlink": true,
                "versions": {
                    "uiskz/currency": "1.0.0"
                }
            }
        },
        {
            "name": "uiskz/travel",
            "type": "path",
            "url": "../uiskz-travel",
            "options": {
                "symlink": true,
                "versions": {
                    "uiskz/travel": "1.0.0"
                }
            }
        }
    ]
}
